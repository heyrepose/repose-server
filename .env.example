NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:4001

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/repose_dev?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

OTP_DELIVERY_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=dev-master-key

# Cloudinary — paste "API environment variable" from Console → Settings → API Keys
# https://console.cloudinary.com/app/settings/api-keys
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Or set individually (cloud_name is a short id, NOT the api_secret):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=repose

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

FCM_SERVICE_ACCOUNT_JSON=

COMMISSION_RATE=0.10
ORDER_AUTO_CONFIRM_DAYS=7
ORDER_SHIP_TIMEOUT_DAYS=5
ORDER_DISPUTE_WINDOW_DAYS=3
WALLET_CLEARANCE_DAYS=7

SEED_ADMIN_EMAIL=admin@repose.ae
SEED_ADMIN_PASSWORD=
