// ─────────────────────────────────────────────────────────────
// Repose — Prisma schema
// Binding contract: documentation/01-DATABASE.md
// Money: Decimal(10,2) AED. IDs: UUID v4. Tables: snake_case via @@map.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id               String     @id @default(uuid())
  email            String?    @unique
  phone            String?    @unique
  passwordHash     String?
  fullName         String
  username         String?    @unique
  avatarUrl        String?
  bio              String?
  role             UserRole   @default(USER)
  status           UserStatus @default(ACTIVE)
  isPhoneVerified  Boolean    @default(false)
  isEmailVerified  Boolean    @default(false)
  ratingAvg        Decimal    @default(0) @db.Decimal(3, 2)
  ratingCount      Int        @default(0)
  itemsSoldCount   Int        @default(0)
  itemsBoughtCount Int        @default(0)
  fcmTokens        String[]   @default([])
  notifyOrderUpdates Boolean  @default(true)
  notifyMessages     Boolean  @default(true)
  notifyMarketing    Boolean  @default(true)
  lastActiveAt     DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  addresses             Address[]
  listings              Listing[]
  ordersAsBuyer         Order[]        @relation("BuyerOrders")
  wallet                SellerWallet?
  savedListings         SavedListing[]
  cart                  Cart?
  notifications         Notification[]
  reviewsGiven          Review[]       @relation("ReviewsGiven")
  reviewsReceived       Review[]       @relation("ReviewsReceived")
  conversationsAsBuyer  Conversation[] @relation("BuyerConversations")
  conversationsAsSeller Conversation[] @relation("SellerConversations")
  messages              Message[]

  @@index([status])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model OtpVerification {
  id         String     @id @default(uuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
  @@map("otp_verifications")
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  RESET_PASSWORD
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String
  emirate    String
  country    String   @default("AE")
  postalCode String?
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  ordersDeliveredTo Order[]

  @@index([userId])
  @@map("addresses")
}

// ───────────────────────── Catalog ─────────────────────────

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  bannerUrl String?
  iconUrl   String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")

  listings Listing[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Listing {
  id           String           @id @default(uuid())
  sellerId     String
  seller       User             @relation(fields: [sellerId], references: [id])
  categoryId   String
  category     Category         @relation(fields: [categoryId], references: [id])
  title        String?
  description  String?
  brand        String?
  size         String?
  condition    ListingCondition?
  priceAed     Decimal?         @db.Decimal(10, 2)
  status       ListingStatus    @default(DRAFT)
  isFeatured   Boolean          @default(false)
  boostedUntil DateTime?
  viewCount    Int              @default(0)
  attributes   Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  publishedAt  DateTime?
  soldAt       DateTime?

  images        ListingImage[]
  orderItems    OrderItem[]
  savedBy       SavedListing[]
  cartItems     CartItem[]
  conversations Conversation[]

  @@index([categoryId, status])
  @@index([sellerId, status])
  @@index([status, publishedAt])
  @@index([status, isFeatured])
  @@map("listings")
}

enum ListingCondition {
  NEW_WITH_TAGS
  NEW_WITHOUT_TAGS
  VERY_GOOD
  GOOD
  SATISFACTORY
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  REMOVED
  FLAGGED
}

model ListingImage {
  id        String  @id @default(uuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@index([listingId])
  @@map("listing_images")
}

model SavedListing {
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
  @@index([listingId])
  @@map("saved_listings")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  cartId    String
  listingId String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@id([cartId, listingId])
  @@index([listingId])
  @@map("cart_items")
}

// ───────────────────────── Orders & Money ─────────────────────────

model Order {
  id             String      @id @default(uuid())
  buyerId        String
  buyer          User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  addressId      String
  address        Address     @relation(fields: [addressId], references: [id])
  status         OrderStatus @default(PENDING_PAYMENT)
  // Money — seller-side commission: buyer pays subtotal; commission deducted from seller proceeds.
  subtotalAed    Decimal     @db.Decimal(10, 2)
  commissionAed  Decimal     @db.Decimal(10, 2)
  totalAed       Decimal     @db.Decimal(10, 2)
  // Shipping address snapshot (immutable copy so editing/deleting Address never mutates history).
  shipName       String?
  shipLine1      String?
  shipLine2      String?
  shipCity       String?
  shipEmirate    String?
  shipCountry    String?
  shipPostalCode String?
  shipPhone      String?
  courierName    String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  disputeReason  String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items         OrderItem[]
  payment       Payment?
  statusHistory OrderStatusHistory[]
  reviews       Review[]

  @@index([buyerId, status])
  @@index([status, createdAt])
  @@map("orders")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID_HELD
  SHIPPED
  DELIVERED
  RELEASED
  CANCELLED
  REFUNDED
  DISPUTED
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  sellerId  String
  priceAed  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([sellerId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model Payment {
  id               String        @id @default(uuid())
  orderId          String        @unique
  order            Order         @relation(fields: [orderId], references: [id])
  provider         String        @default("stripe")
  providerIntentId String
  amountAed        Decimal       @db.Decimal(10, 2)
  status           PaymentStatus @default(REQUIRES_ACTION)
  capturedAt       DateTime?
  releasedAt       DateTime?
  refundedAt       DateTime?
  failureReason    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([providerIntentId])
  @@map("payments")
}

enum PaymentStatus {
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  RELEASED
  FAILED
  REFUNDED
}

model SellerWallet {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  stripeAccountId    String?
  onboardingComplete Boolean  @default(false)
  // Split balance: available = withdrawable now; pending = cleared after WALLET_CLEARANCE_DAYS.
  balanceAed         Decimal  @default(0) @db.Decimal(10, 2)
  pendingAed         Decimal  @default(0) @db.Decimal(10, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ledger WalletTransaction[]

  @@map("seller_wallets")
}

model WalletTransaction {
  id               String       @id @default(uuid())
  walletId         String
  wallet           SellerWallet @relation(fields: [walletId], references: [id])
  type             WalletTxType
  amountAed        Decimal      @db.Decimal(10, 2)
  referenceOrderId String?
  note             String?
  availableAt      DateTime?
  createdAt        DateTime     @default(now())

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

enum WalletTxType {
  SALE_CREDIT
  WITHDRAWAL
  COMMISSION_DEBIT
  ADJUSTMENT
}

// ───────────────────────── Chat ─────────────────────────

model Conversation {
  id            String    @id @default(uuid())
  listingId     String?
  listing       Listing?  @relation(fields: [listingId], references: [id])
  buyerId       String
  buyer         User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  sellerId      String
  seller        User      @relation("SellerConversations", fields: [sellerId], references: [id])
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  messages Message[]

  @@unique([listingId, buyerId, sellerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String?
  attachmentUrl  String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ───────────────────────── Trust ─────────────────────────

model Review {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  reviewerId String
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId String
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([orderId, reviewerId])
  @@index([revieweeId])
  @@map("reviews")
}

// ───────────────────────── Notifications ─────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

enum NotificationType {
  NEW_MESSAGE
  OFFER_RECEIVED
  ITEM_SOLD
  ORDER_UPDATE
  SYSTEM
}

// ───────────────────────── Payments idempotency ─────────────────────────
// Stripe redelivers webhooks; every event id is recorded so handlers are safe to run twice.

model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String   @default("stripe")
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())

  @@map("webhook_events")
}
